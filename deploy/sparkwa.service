[Unit]
Description=SparkWA — Headless WhatsApp to Gemini Spark Bridge
Documentation=https://krishujeniya.github.io/sparkwa/
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sparkwa
Group=sparkwa
WorkingDirectory=/var/lib/sparkwa

# Execution command
ExecStart=/usr/local/bin/sparkwa run --config /etc/sparkwa/config.env

# Restart on failure or disconnect
Restart=always
RestartSec=10s

# Resource and file limits
LimitNOFILE=65536

# Security & Sandboxing (Defense in depth)
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sparkwa
ReadOnlyPaths=/etc/sparkwa
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# Environment
Environment=PATH=/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sparkwa

[Install]
WantedBy=multi-user.target
