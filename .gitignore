# ==============================================================================
# SparkWA — Git Ignore Rules
# ==============================================================================

# --- Binaries & Build Artifacts ---
bin/
dist/
build/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/sparkwa
/sparkwa-*
!sparkwa.service
!docs/assets/**

# --- Packaging & Distribution ---
*.deb
*.rpm
*.apk
*.tar.gz
*.tgz
*.zip
*.7z

# --- Test & Coverage Outputs ---
coverage.txt
coverage.html
profile.out
*.coverprofile
*.cpuprofile
*.memprofile

# --- Secrets, Credentials & Local Config ---
.env
.env.*
!.env.example
config.env
config.env.*
credentials.json
token.json
client_secret*.json
*.pem
*.key
*.crt
*.pfx
*.p12
*service_account*.json
google-creds*.json

# --- SQLite Databases & Runtime State ---
data/
/data/
*.db
*.db-*
*.sqlite
*.sqlite3
*.db.bak
*.db-journal
*.db-wal
*.db-shm

# --- Application Logs ---
*.log
logs/
/var/

# --- Backups & Scratch Files ---
*.bak
*.backup
*.tmp
tmp/
scratch/
*~
*.orig

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Caches ---
.idea/
.vscode/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
.project
.settings/

# --- AI & Agent Sessions ---
.gemini/
.claude/
.system_generated/
AI_HANDOFF.md
AI_HANDOFF*.md
*.handoff.md


