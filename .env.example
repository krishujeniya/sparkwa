# ==============================================================================
# SPARKWA CONFIGURATION TEMPLATE
# Copy to /etc/sparkwa/config.env (or ./config.env) and restrict permissions:
#   chmod 0600 /etc/sparkwa/config.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WHATSAPP CONFIGURATION
# ------------------------------------------------------------------------------
# Phone Number 1: The bot account scanned via Linked Devices terminal QR code.
# Must be in international E.164 format: +<country_code><subscriber_number>
BOT_PHONE_NUMBER="+1234567890"

# Phone Number 2: Your personal phone number.
# CRITICAL: SparkWA strictly fails closed and only accepts messages from this number.
# All messages from any other sender, group, or broadcast are silently ignored.
AUTHORIZED_PHONE_NUMBER="+1987654321"

# ------------------------------------------------------------------------------
# 2. GOOGLE GMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Bridge Mailbox: The Google account used by SparkWA to dispatch commands
# and receive replies from Gemini Spark.
BRIDGE_GMAIL_ADDRESS="bot-bridge@gmail.com"

# Spark Mailbox: The Google account where your existing Gemini Spark tasks run.
# SparkWA will address command envelopes to this inbox to trigger your Spark schedule.
SPARK_GMAIL_ADDRESS="personal-spark@gmail.com"

# ------------------------------------------------------------------------------
# 3. PATHS AND DATA STORAGE
# ------------------------------------------------------------------------------
# Persistent directory for SQLite databases and tokens (mode 0700)
DATA_DIR="/var/lib/sparkwa"

# Google Cloud OAuth 2.0 Client credentials JSON (downloaded from GCP Console)
GMAIL_CREDENTIALS_FILE="/etc/sparkwa/credentials.json"

# Saved Google OAuth 2.0 access & refresh token file (created by 'sparkwa gmail-auth')
GMAIL_TOKEN_FILE="/var/lib/sparkwa/token.json"

# SQLite databases (defaults to inside DATA_DIR)
# DB_PATH="/var/lib/sparkwa/sparkwa.db"
# WHATSAPP_DB_PATH="/var/lib/sparkwa/whatsapp.db"

# ------------------------------------------------------------------------------
# 4. RUNTIME, POLLING & LIMITS
# ------------------------------------------------------------------------------
# Polling interval for detecting replies from Gemini Spark in the bridge inbox.
# Recommended default is 45s. Minimum is 10s to conserve Gmail API quota.
GMAIL_POLL_INTERVAL="45s"

# Timeout before an unresponded task is marked EXPIRED.
TASK_TIMEOUT="15m"

# Spark response detection mode: draft_or_email, email_only, draft_only
SPARK_RESPONSE_MODE="draft_or_email"

# Maximum concurrent tasks awaiting Spark execution
MAX_CONCURRENT_JOBS="5"

# Maximum message length permitted from WhatsApp Number 2
MAX_MESSAGE_LENGTH="4000"

# Logging verbosity: debug, info, warn, error
LOG_LEVEL="info"

# Local loopback HTTP port used for headless OAuth browser redirect callback
OAUTH_LOCAL_PORT="8085"
